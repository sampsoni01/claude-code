  padding: 14px 22px 18px; border-top: 1px solid rgba(220, 181, 77, 0.22);
}
.confirm-text { line-height: 1.6; }

#toast-root { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 90; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; }
.toast {
  background: linear-gradient(170deg, #33191f, #1e0d12);
  border: 1px solid var(--gold-line); color: var(--text);
  border-radius: 999px; padding: 10px 22px; font-size: 13.5px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  opacity: 0; transform: translateY(12px); transition: all .3s;
}
.toast.show { opacity: 1; transform: none; }
.toast-error { border-color: var(--crimson-hi); color: #ffd9d2; }
.toast-good { border-color: var(--good); }

#fx-root { position: fixed; inset: 0; z-index: 80; pointer-events: none; }
.floater {
  position: absolute; transform: translate(-50%, 0); z-index: 81;
  font-family: var(--serif); font-weight: 700; font-size: 22px;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9); opacity: 0; transition: all 1.1s ease-out;
}
.floater.rise { opacity: 1; transform: translate(-50%, -64px); }
.f-dmg { color: #ff6a5e; font-size: 26px; }
.f-heal { color: var(--good); }
.f-block { color: #9fc6e8; font-size: 18px; }
.f-buff { color: var(--gold-hi); font-size: 17px; }
.f-debuff { color: #d78ae0; font-size: 17px; }
.f-play, .f-move { color: var(--gold); font-size: 14.5px; font-style: italic; }
.f-move { color: var(--crimson-hi); }

.shake { animation: shake .42s ease; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-7px) rotate(-1deg); }
  40% { transform: translateX(6px) rotate(1deg); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(3px); }
}
.acting { animation: acting .45s ease; }
@keyframes acting { 30% { transform: translateY(10px) scale(1.05); } }

.round-banner {
  position: absolute; left: 50%; top: 34%; transform: translate(-50%, -50%) scale(.9);
  font-family: var(--serif); font-size: 40px; letter-spacing: 8px; color: var(--gold-hi);
  text-shadow: 0 0 30px rgba(232, 182, 74, 0.7), 0 3px 6px rgba(0, 0, 0, 0.9);
  padding: 14px 54px; opacity: 0; transition: all .3s ease; white-space: nowrap;
  border-top: 1px solid var(--gold-line); border-bottom: 1px solid var(--gold-line);
  background: linear-gradient(90deg, transparent, rgba(24, 8, 12, 0.85) 18%, rgba(24, 8, 12, 0.85) 82%, transparent);
}
.round-banner.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }
.round-banner.passive { font-size: 24px; letter-spacing: 3px; color: #e8c7ff; top: 28%; }

/* ---------- title ---------- */

.title-wrap { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; text-align: center; }
.title-emblem {
  width: 130px; height: 130px; border-radius: 26px; display: grid; place-items: center;
  font-family: var(--serif); font-size: 76px; color: var(--ink);
  background: var(--brush), var(--gold-surface);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.6), inset 0 -6px 10px rgba(90, 62, 8, 0.55), 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 80px rgba(220, 181, 77, 0.28);
}
.title-logo { font-family: var(--serif); font-size: clamp(44px, 8vw, 84px); letter-spacing: 20px; margin-left: 20px; }
.title-sub { font-family: var(--serif); font-style: italic; letter-spacing: 5px; color: var(--crimson-hi); font-size: 15px; text-transform: lowercase; }
.title-foot { margin-top: 26px; color: var(--text-dim); font-size: 13px; letter-spacing: 1px; }

/* ---------- hub ---------- */

.hub-wrap { max-width: 1180px; margin: 0 auto; }
.hub-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
.hub-stats { display: flex; gap: 22px; color: var(--text-dim); font-size: 13px; }
.hub-stats b { color: var(--gold-hi); font-family: var(--serif); margin-left: 5px; }
.hub-resume { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
.hub-tile {
  position: relative; border-radius: 16px; padding: 26px 24px 24px; cursor: pointer; overflow: hidden;
  background: linear-gradient(165deg, #31171f 0%, #22101680 60%), linear-gradient(165deg, var(--lacquer2), #1a0b10);
  border: 1px solid var(--gold-line);
  box-shadow: var(--shadow-lg), inset 0 1px 0 rgba(249, 238, 198, 0.14);
  transition: border-color .2s, box-shadow .2s;
}
.hub-tile:hover { border-color: var(--gold); box-shadow: var(--shadow-lg), 0 0 30px rgba(220, 181, 77, 0.18); }
.hub-glyph {
  font-size: 42px; font-family: var(--serif); margin-bottom: 14px;
  width: 74px; height: 74px; display: grid; place-items: center; border-radius: 16px;
  background: rgba(0, 0, 0, 0.4); border: 1px solid var(--gold-line);
  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
  text-shadow: 0 0 18px rgba(232, 182, 74, 0.5);
}
.hub-name { font-family: var(--serif); font-size: 21px; letter-spacing: 3px; margin-bottom: 8px; }
.hub-desc { color: var(--text-dim); font-size: 13px; line-height: 1.55; }

/* ---------- collection ---------- */

.coll-wrap, .team-wrap, .summon-wrap, .settings-wrap, .exp-wrap, .studio-wrap { max-width: 1220px; margin: 0 auto; }
.coll-count { color: var(--text-dim); font-size: 13px; letter-spacing: 1.5px; margin: 14px 0; text-transform: uppercase; }
.char-grid { display: flex; flex-wrap: wrap; gap: 20px; padding: 6px; }
.card-grid { display: flex; flex-wrap: wrap; gap: 20px; padding: 12px 6px; }
.card-strip { display: flex; flex-wrap: wrap; gap: 14px; padding: 10px 4px; }
.relic-list { padding: 6px 2px; }

.hero-detail { display: grid; grid-template-columns: 300px 1fr; gap: 24px; }
.hd-art { border-radius: 14px; overflow: hidden; border: 2px solid var(--gold-mid); box-shadow: var(--shadow-lg); }
.hd-art img { width: 100%; display: block; }
.hd-meta { display: flex; gap: 8px; align-items: center; margin: 12px 0 4px; }
.hd-role { font-size: 12.5px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); }
.hd-stats { display: flex; flex-wrap: wrap; margin: 8px -3px; }
.hd-innate {
  margin-top: 10px; padding: 12px 14px; border-radius: 10px; font-size: 13px; line-height: 1.5;
  background: linear-gradient(170deg, rgba(220, 181, 77, 0.1), rgba(220, 181, 77, 0.03));
  border: 1px solid var(--gold-line);
}
.hd-innate b { color: var(--gold-hi); }
.hd-lore { margin-top: 12px; font-style: italic; color: var(--text-dim); font-size: 13.5px; line-height: 1.65; }
.hd-cards-title { font-family: var(--serif); letter-spacing: 2.5px; font-size: 14px; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; }
@media (max-width: 860px) { .hero-detail { grid-template-columns: 1fr; } }

/* ---------- team ---------- */

.team-slots { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
.team-slot { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 16px 16px; }
.ts-index {
  position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
  width: 30px; height: 26px; display: grid; place-items: center;
  font-family: var(--serif); font-weight: 700; color: #241503; border-radius: 7px;
  background: var(--brush), var(--gold-surface); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
}
.ts-info { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 12px; color: var(--text-dim); text-align: center; }
.ts-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.ts-empty {
  width: 148px; height: 210px; border-radius: 14px; cursor: pointer;
  border: 2px dashed rgba(220, 181, 77, 0.4); background: rgba(0, 0, 0, 0.25);
  color: var(--gold); font-family: var(--serif); font-size: 14px; letter-spacing: 1px;
  transition: all .2s;
}
.ts-empty:hover { border-color: var(--gold); background: rgba(220, 181, 77, 0.08); }
.roster-grid { justify-content: center; }
.roster-pick { position: relative; cursor: pointer; }
.roster-pick.in-team .char-card { outline: 2px solid var(--crimson); }
.roster-flag {
  position: absolute; top: 8px; left: 50%; transform: translateX(-50%); z-index: 8;
  font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
  background: var(--crimson); color: #ffe3dd; padding: 3px 9px; border-radius: 999px;
}

.deck-editor { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.de-col { min-width: 0; }
.de-head { font-family: var(--serif); letter-spacing: 2px; font-size: 13.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 6px; }
.de-head .good { color: var(--good); }
.de-head .bad { color: var(--bad); }
.de-hint { color: var(--text-dim); text-transform: none; letter-spacing: 0; font-size: 12px; }
.de-entry { cursor: pointer; }
.de-entry:hover .az-card { outline: 1px solid var(--gold); }
@media (max-width: 880px) { .deck-editor { grid-template-columns: 1fr; } }

/* ---------- summon ---------- */

.banner-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; }
.banner {
  position: relative; overflow: hidden; border-radius: 18px; padding: 30px 26px;
  display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px;
  border: 1px solid var(--gold-line);
  background:
    radial-gradient(90% 60% at 50% -10%, rgba(220, 181, 77, 0.16), transparent 60%),
    linear-gradient(170deg, #331721 0%, #1d0d12 70%);
  box-shadow: var(--shadow-lg);
}
.banner-hero { background: radial-gradient(90% 60% at 50% -10%, rgba(224, 49, 69, 0.22), transparent 60%), linear-gradient(170deg, #3a1620, #1d0d12 70%); }
.banner-glyph {
  font-family: var(--serif); font-size: 64px; line-height: 1;
  color: var(--gold); text-shadow: 0 0 34px rgba(232, 182, 74, 0.6), 0 4px 8px rgba(0, 0, 0, 0.7);
}
.banner-name { font-family: var(--serif); font-size: 22px; letter-spacing: 3px; }
.banner-desc { color: var(--text-dim); font-size: 13px; line-height: 1.55; min-height: 42px; }
.banner-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

.reveal-grid { display: flex; flex-wrap: wrap; gap: 18px; justify-content: center; perspective: 1200px; }
.flip-card { width: 196px; min-height: 270px; cursor: pointer; animation: dropIn .5s ease backwards; }
@keyframes dropIn { from { opacity: 0; transform: translateY(-36px) rotateZ(-2deg); } }
.flip-inner {
  position: relative; width: 100%; height: 100%; min-height: 270px;
  transform-style: preserve-3d; transition: transform .65s cubic-bezier(.2, .7, .3, 1.1);
}
.flip-card.flipped .flip-inner { transform: rotateY(180deg); }
.flip-back, .flip-face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 13px; }
.flip-back {
  display: grid; place-items: center; font-family: var(--serif); font-size: 68px; color: var(--gold);
  background:
    radial-gradient(60% 60% at 50% 40%, rgba(220, 181, 77, 0.14), transparent 70%),
    var(--brush), linear-gradient(160deg, #40202b, #24101a);
  border: 2px solid var(--gold-mid);
  box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.6), var(--shadow-lg);
  text-shadow: 0 0 26px rgba(232, 182, 74, 0.6);
}
.flip-face { transform: rotateY(180deg); display: flex; flex-direction: column; align-items: center; }
.flip-face .az-card, .flip-face .char-card { width: 100%; }
.flip-face.fr-SSR { filter: drop-shadow(0 0 22px rgba(232, 182, 74, 0.55)); }
.flip-face.fr-UR { filter: drop-shadow(0 0 26px rgba(240, 90, 90, 0.6)); }
.reveal-note {
  margin-top: 8px; font-family: var(--serif); letter-spacing: 2px; font-size: 13px; color: var(--gold-hi);
  text-shadow: 0 0 14px rgba(232, 182, 74, 0.7);
}

/* ---------- settings ---------- */

.set-panel { margin-bottom: 18px; }
.toggle-row {
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  padding: 12px 6px; cursor: pointer; border-bottom: 1px solid rgba(220, 181, 77, 0.12);
}
.toggle-row:last-child { border-bottom: none; }
.toggle-info { display: flex; flex-direction: column; gap: 3px; }
.toggle-info b { color: var(--gold-hi); font-family: var(--serif); letter-spacing: 0.5px; }
.toggle-info span { color: var(--text-dim); font-size: 12.5px; max-width: 640px; }
.toggle-pill {
  width: 52px; height: 28px; border-radius: 999px; flex-shrink: 0; position: relative;
  background: rgba(0, 0, 0, 0.55); border: 1px solid rgba(220, 181, 77, 0.35); transition: all .2s;
}
.toggle-dot {
  position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%;
  background: linear-gradient(160deg, #8f8577, #565048); transition: all .2s;
}
.toggle-pill.on { background: linear-gradient(180deg, rgba(220, 181, 77, 0.4), rgba(220, 181, 77, 0.14)); border-color: var(--gold); }
.toggle-pill.on .toggle-dot { left: 27px; background: var(--brush), var(--gold-surface); box-shadow: 0 0 10px rgba(232, 182, 74, 0.6); }
.set-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

.codex h3 { font-family: var(--serif); color: var(--gold); letter-spacing: 2px; margin: 18px 0 8px; font-size: 16px; }
.codex h3:first-child { margin-top: 0; }
.codex p { line-height: 1.65; font-size: 13.5px; margin-bottom: 8px; }
.codex b { color: var(--gold-hi); }
.codex-status { font-size: 13px; padding: 4px 0; }
.codex-status b { color: var(--gold-hi); }

/* ---------- expedition ---------- */

.exp-need { display: flex; align-items: center; gap: 18px; justify-content: space-between; flex-wrap: wrap; }
.exp-start { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
.exp-start-title { font-family: var(--serif); letter-spacing: 2px; color: var(--gold); }
.exp-tiers { display: flex; gap: 10px; flex-wrap: wrap; }
.exp-team-preview { display: flex; gap: 12px; flex-wrap: wrap; }

.exp-path { display: flex; align-items: center; margin: 10px 0 22px; flex-wrap: wrap; row-gap: 12px; }
.exp-node {
  width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center;
  font-size: 21px; flex-shrink: 0;
  background: rgba(0, 0, 0, 0.5); border: 2px solid rgba(220, 181, 77, 0.3);
  color: var(--text-dim); position: relative; transition: all .25s;
}
.exp-node.done { border-color: var(--gold-deep); color: var(--gold-deep); background: rgba(124, 95, 27, 0.12); }
.exp-node.current {
  border-color: var(--gold); color: var(--gold-hi); transform: scale(1.18);
  box-shadow: 0 0 24px rgba(232, 182, 74, 0.5), inset 0 0 12px rgba(232, 182, 74, 0.2);
  animation: nodePulse 1.8s ease infinite;
}
@keyframes nodePulse { 50% { box-shadow: 0 0 36px rgba(232, 182, 74, 0.75), inset 0 0 12px rgba(232, 182, 74, 0.3); } }
.exp-link { height: 2px; flex: 1; min-width: 14px; background: rgba(220, 181, 77, 0.2); }
.exp-link.done { background: var(--gold-deep); }

.exp-hp-strip { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 26px; }
.exp-hp { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-dim); }
.exp-hp img { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--gold-line); object-fit: cover; }

.exp-doors-title { font-family: var(--serif); letter-spacing: 2.5px; font-size: 15px; color: var(--gold); text-transform: uppercase; margin-bottom: 14px; }
.exp-doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 320px)); gap: 20px; }
.door {
  position: relative; overflow: hidden; cursor: pointer;
  border-radius: 16px 16px 6px 6px; padding: 30px 22px 24px; text-align: center;
  background:
    radial-gradient(80% 45% at 50% -6%, rgba(224, 49, 69, 0.2), transparent 65%),
    linear-gradient(172deg, #351822 0%, #1e0d13 75%);
  border: 1px solid var(--gold-line); border-top: 3px solid var(--gold-mid);
  box-shadow: var(--shadow-lg);
  transition: border-color .2s, box-shadow .2s;
}
.door:hover { border-color: var(--gold); box-shadow: var(--shadow-lg), 0 0 34px rgba(220, 181, 77, 0.22); }
.door-icon { font-size: 44px; margin-bottom: 12px; text-shadow: 0 0 22px rgba(232, 182, 74, 0.5); }
.door-name { font-family: var(--serif); font-size: 19px; letter-spacing: 3px; margin-bottom: 8px; }
.door-desc { color: var(--text-dim); font-size: 12.5px; line-height: 1.5; }

.event-box { text-align: center; padding: 8px 4px; }
.event-glyph { font-family: var(--serif); font-size: 58px; color: var(--gold); text-shadow: 0 0 26px rgba(232, 182, 74, 0.5); margin-bottom: 12px; }
.event-desc { color: var(--text); line-height: 1.7; font-size: 14.5px; font-style: italic; }
.event-line { font-family: var(--serif); font-size: 16px; color: var(--gold-hi); padding: 4px 0; }
.run-complete { text-align: center; padding: 10px; }
.rc-glyph { font-size: 60px; margin-bottom: 10px; }
.rc-bonus { font-family: var(--serif); font-size: 19px; color: var(--gold-hi); margin-top: 10px; }

/* ---------- battle ---------- */

#screen-battle { padding: 14px 20px 10px; display: flex; }
.battle-shell { flex: 1; display: flex; flex-direction: column; max-width: 1280px; margin: 0 auto; width: 100%; position: relative; }
.battle-shell.locked .hand-dock, .battle-shell.locked .unit { pointer-events: none; }

.b-top { display: flex; align-items: center; gap: 16px; margin-bottom: 6px; min-height: 40px; }
.b-round { font-family: var(--serif); letter-spacing: 1.5px; color: var(--text-dim); font-size: 14px; }
.b-round b { color: var(--gold-hi); }
.b-passives { flex: 1; display: flex; gap: 6px; flex-wrap: wrap; }
.passive-chip {
  font-size: 11.5px; padding: 4px 10px; border-radius: 999px; cursor: help;
  background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(220, 181, 77, 0.4); color: var(--gold-hi);
  box-shadow: 0 0 12px rgba(232, 182, 74, 0.12);
}
.passive-chip b { color: var(--crimson-hi); }
.passive-chip.pc-enemy { border-color: rgba(224, 49, 69, 0.5); color: #eaa9b0; }
.b-controls { display: flex; gap: 8px; }

.arena {
  position: relative; flex: 1; min-height: 380px;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 18px 10px 6px; perspective: 1100px;
}
.arena-floor {
  position: absolute; left: 4%; right: 4%; top: 42%; bottom: 8%;
  border-radius: 50%; pointer-events: none;
  background: radial-gradient(ellipse at 50% 50%, rgba(163, 18, 32, 0.16), rgba(220, 181, 77, 0.05) 55%, transparent 72%);
  border: 1px solid rgba(220, 181, 77, 0.12);
  transform: rotateX(58deg);
}
.enemy-row { display: flex; justify-content: center; gap: 26px; flex-wrap: wrap; z-index: 2; }
.ally-row { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; z-index: 3; margin-top: 14px; }

.unit {
  position: relative; width: 150px; padding: 8px 8px 10px; border-radius: 13px; cursor: pointer;
  background: linear-gradient(170deg, rgba(43, 20, 28, 0.92), rgba(24, 10, 14, 0.92));
  border: 1px solid rgba(220, 181, 77, 0.3);
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.5);
  transition: transform .18s ease, border-color .18s, box-shadow .18s, opacity .3s, filter .3s;
}
.unit.enemy { width: 158px; }
.unit:hover { transform: translateY(-4px); }
.unit-portrait { height: 118px; border-radius: 9px; overflow: hidden; border: 1px solid rgba(220, 181, 77, 0.35); }
.unit.enemy .unit-portrait { height: 128px; }
.unit-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
.unit-name { font-family: var(--serif); font-size: 13px; color: var(--gold-hi); margin-top: 6px; line-height: 1.2; }
.unit-name i { font-style: normal; font-size: 10.5px; color: var(--text-dim); }
.unit-crown { position: absolute; top: -14px; right: -8px; font-size: 22px; z-index: 6; filter: drop-shadow(0 2px 4px rgba(0,0,0,.8)); }

.hp-row { display: flex; align-items: center; gap: 6px; margin-top: 5px; }
.hp-bar {
  position: relative; flex: 1; height: 15px; border-radius: 999px; overflow: hidden;
  background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(220, 181, 77, 0.3);
}
.hp-bar.sm { height: 8px; width: 70px; flex: none; }
.hp-fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(180deg, #e04a55, var(--crimson) 60%, #7c0e17);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  transition: width .45s ease;
}
.hp-fill.low { background: linear-gradient(180deg, #ff8a5e, #c23a12); animation: lowHp 1.2s ease infinite; }
@keyframes lowHp { 50% { filter: brightness(1.35); } }
.hp-num {
  position: absolute; inset: 0; display: grid; place-items: center;
  font-size: 10px; font-weight: 700; color: #ffe9e2; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
.block-badge {
  font-size: 11.5px; font-weight: 700; color: #cfe4f5;
  background: linear-gradient(170deg, #2c4a63, #17293a); border: 1px solid #6d9cc4;
  padding: 2px 7px; border-radius: 999px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
}
.status-row { min-height: 20px; margin-top: 4px; display: flex; flex-wrap: wrap; }

.unit-flag {
  position: absolute; top: -10px; left: 50%; transform: translateX(-50%); z-index: 6;
